+  departmentPath: z.string().trim().optional(),
+  role: z.enum(["MEMBER", "ADMIN"]).optional(),
+});
+
+export type MemberInput = z.infer<typeof MemberInput>;
+
+/** Role hợp lệ khi import. */
+export type ImportRole = "MEMBER" | "ADMIN";
