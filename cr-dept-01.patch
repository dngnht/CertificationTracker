-        name: true,
-        provider: true,
-        isRecommendedFeatured: true,
-        goldReward: true,
-      },
-    }),
-    prisma.certificationAssignment.groupBy({
-      by: ["certificationId"],
-      where: { createdAt: { gte: windowStart } },
-      _count: { _all: true },
