# --- Database ---
DATABASE_URL="postgresql://certtracker:certtracker@localhost:5432/certtracker"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-secret"

# Microsoft Entra ID (Azure AD) OAuth
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"

# Enable a dev-only login screen (pick a seeded user) when true.
# NEVER enable in production.
AUTH_ENABLE_DEV_LOGIN="true"

# --- Azure Blob Storage ---
# Storage backend: "azure" or "local" (local is for development only)
FILE_STORAGE="local"
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER_NAME="certificates"

# --- Business rules ---
CERTIFICATION_EXPIRING_SOON_DAYS=30
MAX_CERTIFICATE_FILE_SIZE_MB=10
REMINDER_COOLDOWN_HOURS=24

# --- Email / Reminders ---
# Notification backend: "console" (dev) or "resend"
NOTIFICATION_BACKEND="console"
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Certification Tracker <no-reply@example.com>"
APP_URL="http://localhost:3000"

# --- AI Assist (Module A) ---
# Provider abstraction: "openai-compatible" (OpenAI / OpenRouter / any compatible
# endpoint) or "azure-openai". Supply your OWN provider key here.
AI_PROVIDER="openai-compatible"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"
# Azure OpenAI (only when AI_PROVIDER=azure-openai)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-06-01"
AI_MAX_BULK_MUTATION=200
AI_CONVERSATION_PERSIST="true"

# --- Gold rewards (Module B) ---
GOLD_CLAWBACK_ON_EXPIRE="false"
GOLD_LEADERBOARD_ENABLED="true"

# --- OCR extraction (CR-OCR-01) ---
FEATURE_OCR_EXTRACTION="true"
# OCR_ENGINE: "easyocr" (real, via Python subprocess) or "stub" (dev/test, no deps)
OCR_ENGINE="stub"
OCR_DEFAULT_LANG="eng"          # or "eng+jpn"
OCR_REVIEW_THRESHOLD="0.75"     # overall confidence gate for auto-create
OCR_SCRIPT_PATH="./scripts/cert_ocr/extract.py"
# EasyOCR offline/security (locked-down networks)
EASYOCR_MODEL_DIR=""
EASYOCR_DOWNLOAD="1"            # set 0 to forbid runtime model download