FROM node:20-bookworm-slim
WORKDIR /app

# The pod egresses through an HTTP(S) proxy. Node's native https ignores proxy
# env vars, so tools that DO honor them (npm, uv) need them exported here.
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY} \
    http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} no_proxy=${NO_PROXY}

# Bootstrap a Python toolchain with uv. The binary is pre-staged in the build
# context (.preview-assets) because github release downloads redirect to
# release-assets.githubusercontent.com, which node cannot reach via the proxy.
COPY .preview-assets/uv-x86_64-unknown-linux-gnu.tar.gz /tmp/uv.tar.gz
RUN tar -xzf /tmp/uv.tar.gz -C /tmp \
    && mv /tmp/uv-x86_64-unknown-linux-gnu/uv /usr/local/bin/uv \
    && rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu

# Install EasyOCR runtime deps (CPU-only torch) into a dedicated venv.
RUN uv venv /opt/ocr-venv \
    && uv pip install --python /opt/ocr-venv/bin/python --no-cache \
         easyocr opencv-python-headless numpy

# Pre-load EasyOCR model weights (detector + english recognizer) so the
# container can run OCR offline. The zips are pre-staged in the build context
# (.preview-assets) because github release downloads are unreachable from the
# build container (node ignores the egress proxy).
ARG OCR_MODEL_DIR=/opt/ocr-venv/lib/python3.14/site-packages/easyocr/model
COPY .preview-assets/craft_mlt_25k.zip .preview-assets/english_g2.zip /tmp/
RUN mkdir -p "${OCR_MODEL_DIR}" \
    && /opt/ocr-venv/bin/python3 -c "import zipfile,sys;zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" /tmp/craft_mlt_25k.zip "${OCR_MODEL_DIR}" \
    && /opt/ocr-venv/bin/python3 -c "import zipfile,sys;zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" /tmp/english_g2.zip "${OCR_MODEL_DIR}" \
    && rm -f /tmp/craft_mlt_25k.zip /tmp/english_g2.zip

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

COPY . .

RUN npx prisma generate && npm run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["sh", "-c", "npx prisma migrate deploy && (npx tsx prisma/seed.ts || true) && npm start -- -H 0.0.0.0 -p 3000"]